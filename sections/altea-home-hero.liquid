{% assign hero_product = all_products[section.settings.product_handle] %}
{% assign hero_image = section.settings.image %}
{% if hero_image == blank and hero_product.featured_image != blank %}
  {% assign hero_image = hero_product.featured_image %}
{% endif %}
{% assign hero_alt = section.settings.heading %}
{% if hero_image.alt != blank %}
  {% assign hero_alt = hero_image.alt %}
{% endif %}
{% assign hero_link = section.settings.button_link %}
{% if hero_link == blank and hero_product.url != blank %}
  {% assign hero_link = hero_product.url %}
{% endif %}

<section class="altea-home-hero" id="AlteaHomeHero-{{ section.id }}">
  <div class="altea-home-hero__inner">
    <div class="altea-home-hero__content">
      {% if section.settings.eyebrow != blank %}
        <p class="altea-home-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h1 class="altea-home-hero__heading">{{ section.settings.heading }}</h1>
      {% endif %}
      {% if section.settings.description != blank %}
        <div class="altea-home-hero__description">{{ section.settings.description }}</div>
      {% endif %}
      {% if section.settings.offer != blank %}
        <p class="altea-home-hero__offer">{{ section.settings.offer }}</p>
      {% endif %}
      <div class="altea-home-hero__actions">
        {% if hero_link != blank %}
          <a class="altea-home-hero__button" href="{{ hero_link }}">{{ section.settings.button_label }}</a>
        {% endif %}
        {% if section.settings.whatsapp_link != blank %}
          <a class="altea-home-hero__whatsapp" href="{{ section.settings.whatsapp_link }}" target="_blank" rel="noopener">{{ section.settings.whatsapp_label }}</a>
        {% endif %}
      </div>
      <div class="altea-home-hero__trust" aria-label="{{ section.settings.trust_label }}">
        {% if section.settings.trust_1 != blank %}<span>{{ section.settings.trust_1 }}</span>{% endif %}
        {% if section.settings.trust_2 != blank %}<span>{{ section.settings.trust_2 }}</span>{% endif %}
        {% if section.settings.trust_3 != blank %}<span>{{ section.settings.trust_3 }}</span>{% endif %}
      </div>
    </div>
    <div class="altea-home-hero__media">
      {% if hero_image != blank %}
        {{ hero_image | image_url: width: 1200 | image_tag: class: 'altea-home-hero__image', loading: 'eager', alt: hero_alt }}
      {% else %}
        <div class="altea-home-hero__fallback" aria-hidden="true"><span>ALTEA</span></div>
      {% endif %}
      {% if section.settings.badge_text != blank %}
        <div class="altea-home-hero__badge" aria-hidden="true">{{ section.settings.badge_text }}</div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .altea-home-hero {
    --altea-navy: #031d42;
    --altea-gold: #d6a65e;
    --altea-ink: #f7f8fb;
    padding: 24px 24px 0;
    background: var(--color-background, #fff);
  }

  .altea-home-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
    max-width: 1400px;
    min-height: 520px;
    margin: 0 auto;
    overflow: hidden;
    border-radius: 22px;
    background: var(--altea-navy);
  }

  .altea-home-hero__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 64px clamp(28px, 6vw, 88px);
    color: var(--altea-ink);
  }

  .altea-home-hero__eyebrow {
    margin: 0 0 18px;
    color: var(--altea-gold);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .16em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .altea-home-hero__heading {
    max-width: 620px;
    margin: 0;
    color: var(--altea-ink);
    font-family: var(--font-heading-family);
    font-size: clamp(38px, 4.8vw, 68px);
    font-weight: var(--font-heading-weight);
    letter-spacing: -.035em;
    line-height: 1.02;
  }

  .altea-home-hero__description {
    max-width: 560px;
    margin-top: 22px;
    color: rgba(247, 248, 251, .82);
    font-size: 17px;
    line-height: 1.6;
  }

  .altea-home-hero__description p { margin: 0; }

  .altea-home-hero__offer {
    display: inline-flex;
    align-self: flex-start;
    margin: 24px 0 0;
    padding: 10px 14px;
    border-left: 3px solid var(--altea-gold);
    background: rgba(214, 166, 94, .12);
    color: var(--altea-gold);
    font-size: 16px;
    font-weight: 700;
  }

  .altea-home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    margin-top: 28px;
  }

  .altea-home-hero__button {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    padding: 0 25px;
    border: 1px solid var(--altea-gold);
    border-radius: 5px;
    background: var(--altea-gold);
    color: var(--altea-navy);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .04em;
    text-decoration: none;
    text-transform: uppercase;
    transition: transform .2s ease, background-color .2s ease;
  }

  .altea-home-hero__button:hover {
    transform: translateY(-2px);
    background: #e6bd7d;
  }

  .altea-home-hero__whatsapp {
    color: var(--altea-ink);
    font-size: 14px;
    font-weight: 700;
    text-underline-offset: 4px;
  }

  .altea-home-hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    margin-top: 28px;
    color: rgba(247, 248, 251, .7);
    font-size: 12px;
    line-height: 1.4;
  }

  .altea-home-hero__trust span {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .altea-home-hero__trust span::before {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--altea-gold);
    content: "";
  }

  .altea-home-hero__media {
    position: relative;
    min-height: 520px;
    overflow: hidden;
    background: #f0eee9;
  }

  .altea-home-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 520px;
    object-fit: cover;
    object-position: center;
  }

  .altea-home-hero__fallback {
    display: grid;
    min-height: 520px;
    place-items: center;
    color: var(--altea-navy);
    font-size: 54px;
    font-weight: 800;
    letter-spacing: .18em;
  }

  .altea-home-hero__badge {
    position: absolute;
    right: 20px;
    bottom: 20px;
    padding: 9px 12px;
    border: 1px solid rgba(255, 255, 255, .35);
    border-radius: 999px;
    background: rgba(3, 29, 66, .82);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .14em;
  }

  @media screen and (max-width: 749px) {
    .altea-home-hero { padding: 12px 12px 0; }
    .altea-home-hero__inner {
      display: flex;
      flex-direction: column;
      border-radius: 16px;
    }
    .altea-home-hero__content {
      order: 1;
      padding: 38px 26px 34px;
    }
    .altea-home-hero__media {
      order: 2;
      min-height: 300px;
    }
    .altea-home-hero__image,
    .altea-home-hero__fallback { min-height: 300px; }
    .altea-home-hero__heading { font-size: clamp(36px, 10vw, 48px); }
    .altea-home-hero__description {
      margin-top: 16px;
      font-size: 15px;
    }
    .altea-home-hero__offer {
      margin-top: 18px;
      font-size: 14px;
    }
    .altea-home-hero__actions {
      align-items: stretch;
      flex-direction: column;
      gap: 14px;
      margin-top: 22px;
    }
    .altea-home-hero__button { width: 100%; }
    .altea-home-hero__whatsapp { text-align: center; }
    .altea-home-hero__trust {
      flex-direction: column;
      gap: 9px;
      margin-top: 22px;
    }
    .altea-home-hero__badge {
      right: 12px;
      bottom: 12px;
      font-size: 8px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero ALTEA",
  "tag": "section",
  "class": "altea-home-hero-section",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Sur-titre","default":"Sécurité · Maison · Sérénité"},
    {"type":"inline_richtext","id":"heading","label":"Titre","default":"Protégez votre foyer avant qu’il ne soit trop tard."},
    {"type":"richtext","id":"description","label":"Description","default":"<p>Des solutions simples et fiables pour prévenir les risques du quotidien et vivre plus sereinement au Maroc.</p>"},
    {"type":"text","id":"offer","label":"Offre","default":"Offre du moment : 2 détecteurs à 599 DH"},
    {"type":"text","id":"button_label","label":"Texte du bouton","default":"Découvrir les solutions"},
    {"type":"url","id":"button_link","label":"Lien du bouton"},
    {"type":"text","id":"whatsapp_label","label":"Texte WhatsApp","default":"Une question ? Écrivez-nous"},
    {"type":"url","id":"whatsapp_link","label":"Lien WhatsApp"},
    {"type":"text","id":"trust_label","label":"Libellé des garanties","default":"Garanties ALTEA"},
    {"type":"text","id":"trust_1","label":"Garantie 1","default":"Paiement à la livraison"},
    {"type":"text","id":"trust_2","label":"Garantie 2","default":"Livraison partout au Maroc"},
    {"type":"text","id":"trust_3","label":"Garantie 3","default":"Assistance WhatsApp"},
    {"type":"text","id":"badge_text","label":"Signature","default":"Protéger · Prévenir · ALTEA"},
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"text","id":"product_handle","label":"Produit utilisé comme image de secours","default":"detecteur-gaz"}
  ],
  "presets": [{"name":"Hero ALTEA"}]
}
{% endschema %}
