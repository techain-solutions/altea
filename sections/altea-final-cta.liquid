{%- comment -%}
  ALTEA — Rappel d'offre orienté conversion
  Mise en page split : visuel produit + bénéfices + prix dynamique.
  Le produit, le prix et le prix barré restent synchronisés avec Shopify.
{%- endcomment -%}

{{ 'section-altea-final-cta.css' | asset_url | stylesheet_tag }}
{%- render 'section-padding', section: section -%}

{%- liquid
  assign s = section.settings

  assign cta_product = product
  unless s.product == blank
    assign cta_product = s.product
  endunless

  assign variant = cta_product.selected_or_first_available_variant

  assign button_url = s.button_url
  if button_url == blank
    if request.page_type == 'product'
      assign button_url = '#MainProduct-main'
    else
      assign button_url = cta_product.url
    endif
  endif

  assign show_price = false
  if s.show_price and variant != blank
    assign show_price = true
  endif

  assign on_sale = false
  assign savings = 0
  if variant.compare_at_price > variant.price
    assign on_sale = true
    assign savings = variant.compare_at_price | minus: variant.price
  endif
-%}

<section
  class="altea-cta show-on--{{ s.show_on }} color-{{ s.custom_color_scheme }} dbtfy-color-{{ s.color_scheme }} section-{{ section.id }}-padding gradient"
  {{ section.shopify_attributes }}
>
  <div class="{{ s.container_size }}">
    <div class="altea-cta__panel">
      <div class="altea-cta__visual">
        <div class="altea-cta__visual-glow" aria-hidden="true"></div>
        {%- if cta_product != blank and cta_product.featured_image != blank -%}
          <div class="altea-cta__product-media">
            {{ cta_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', alt: cta_product.featured_image.alt | default: cta_product.title }}
          </div>
          <span class="altea-cta__visual-badge">
            {% render 'material-icon', icon: 'local_fire_department' %}
            <span>Offre sélectionnée</span>
          </span>
        {%- else -%}
          <div class="altea-cta__fallback" aria-hidden="true">
            {% render 'material-icon', icon: 'shield' %}
          </div>
          <span class="altea-cta__visual-label">Les essentiels ALTEA</span>
        {%- endif -%}
      </div>

      <div class="altea-cta__content">
        {%- if s.eyebrow != blank -%}
          <p class="altea-cta__eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if s.heading != blank -%}
          <h2 class="altea-cta__heading">{{ s.heading }}</h2>
        {%- endif -%}

        {%- if s.text != blank -%}
          <div class="altea-cta__text">{{ s.text }}</div>
        {%- endif -%}

        <div class="altea-cta__highlights" role="list">
          <span role="listitem">{% render 'material-icon', icon: 'local_shipping' %}<span>Livraison partout au Maroc</span></span>
          <span role="listitem">{% render 'material-icon', icon: 'payments' %}<span>Paiement à la livraison</span></span>
          <span role="listitem">{% render 'material-icon', icon: 'support_agent' %}<span>Conseil avant commande</span></span>
        </div>

        {%- if show_price -%}
          <div class="altea-cta__price-row">
            <div class="altea-cta__price-group">
              <span class="altea-cta__price-label">Votre prix</span>
              <p class="altea-cta__price">
                <span class="altea-cta__price-now">{{ variant.price | money }}</span>
                {%- if on_sale -%}
                  <s class="altea-cta__price-was">
                    <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}: </span>
                    {{ variant.compare_at_price | money }}
                  </s>
                {%- endif -%}
              </p>
            </div>
            {%- if on_sale -%}
              <span class="altea-cta__saving">Économisez {{ savings | money }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if s.button_label != blank and button_url != blank -%}
          <a class="altea-cta__button button button--primary" href="{{ button_url }}">
            <span>{{ s.button_label | escape }}</span>
            {% render 'material-icon', icon: 'arrow_forward' %}
          </a>
        {%- endif -%}

        <p class="altea-cta__micro-proof">
          {% render 'material-icon', icon: 'verified_user' %}
          <span>Commande simple, accompagnement humain et livraison au Maroc</span>
        </p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Altea — Rappel d'offre",
  "tag": "section",
  "class": "altea-final-cta-section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Produit",
      "info": "Laisser vide sur une page produit : le produit courant est utilisé."
    },
    { "type": "header", "content": "Contenu" },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "PRÊT À COMMANDER ?"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "Protégez ce qui compte vraiment"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Afficher le prix du produit",
      "info": "Le prix et le prix barré sont lus dans Shopify, jamais écrits dans la section.",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Libellé du bouton",
      "default": "Commander maintenant"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Lien du bouton",
      "info": "Laisser vide pour renvoyer vers la fiche du produit."
    },
    { "type": "header", "content": "Affichage" },
    {
      "type": "select",
      "id": "show_on",
      "label": "Afficher sur",
      "default": "both",
      "options": [
        { "value": "both", "label": "Desktop et mobile" },
        { "value": "desktop-only", "label": "Desktop uniquement" },
        { "value": "mobile-only", "label": "Mobile uniquement" }
      ]
    },
    {
      "type": "select",
      "id": "container_size",
      "label": "Largeur du conteneur",
      "info": "« Standard » applique la classe page-width du thème.",
      "default": "page-width",
      "options": [
        { "value": "page-width", "label": "Standard" },
        { "value": "", "label": "Pleine largeur" }
      ]
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Schéma de couleurs Debutify",
      "default": "scheme-1",
      "options": [
        { "value": "scheme-1", "label": "Clair" },
        { "value": "scheme-2", "label": "Primaire" },
        { "value": "scheme-3", "label": "Secondaire" },
        { "value": "scheme-4", "label": "Foncé" },
        { "value": "custom", "label": "Personnalisé" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "custom_color_scheme",
      "label": "Schéma de couleurs personnalisé",
      "default": "scheme-1"
    },
    { "type": "header", "content": "Espacement" },
    {
      "type": "select",
      "id": "padding___top",
      "label": "Marge haute",
      "default": "medium",
      "options": [
        { "value": "none", "label": "Aucune" },
        { "value": "extra_small", "label": "Très petite" },
        { "value": "small", "label": "Petite" },
        { "value": "medium", "label": "Moyenne" },
        { "value": "large", "label": "Grande" },
        { "value": "custom", "label": "Personnalisée" }
      ]
    },
    {
      "type": "range",
      "id": "custom_padding_top",
      "label": "Marge haute personnalisée",
      "min": 0, "max": 160, "step": 4, "unit": "px",
      "default": 60
    },
    {
      "type": "select",
      "id": "padding___bottom",
      "label": "Marge basse",
      "default": "medium",
      "options": [
        { "value": "none", "label": "Aucune" },
        { "value": "extra_small", "label": "Très petite" },
        { "value": "small", "label": "Petite" },
        { "value": "medium", "label": "Moyenne" },
        { "value": "large", "label": "Grande" },
        { "value": "custom", "label": "Personnalisée" }
      ]
    },
    {
      "type": "range",
      "id": "custom_padding_bottom",
      "label": "Marge basse personnalisée",
      "min": 0, "max": 160, "step": 4, "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "reassurance",
      "name": "Argument de réassurance",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icône",
          "info": "Nom d'un symbole Material (ex. payments, local_shipping, support_agent).",
          "default": "payments"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Texte",
          "default": "Paiement à la livraison"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Altea — Rappel d'offre",
      "blocks": [
        { "type": "reassurance" },
        { "type": "reassurance" },
        { "type": "reassurance" }
      ]
    }
  ]
}
{% endschema %}
