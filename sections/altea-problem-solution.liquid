{%- comment -%}
  ALTEA — Problème → solution

  Section de persuasion placée après la première preuve produit. Elle met en
  regard les irritants concrets du client et la réponse apportée par le produit.
  Les cartes utilisent uniquement des propriétés logiques afin de rester
  homogènes en français comme en arabe.
{%- endcomment -%}

{{ 'section-altea-problem-solution.css' | asset_url | stylesheet_tag }}
{%- render 'section-padding', section: section -%}

{%- liquid
  assign s = section.settings
  assign cta_href = s.cta_link
  if cta_href == blank
    assign cta_href = '#MainProduct-main'
  endif
-%}

<section
  class="altea-problem-solution show-on--{{ s.show_on }} color-{{ s.custom_color_scheme }} dbtfy-color-{{ s.color_scheme }} section-{{ section.id }}-padding"
  {{ section.shopify_attributes }}
>
  <div class="{{ s.container_size }}">
    <header class="altea-problem-solution__header">
      {%- if s.eyebrow != blank -%}
        <p class="altea-problem-solution__eyebrow">{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="altea-problem-solution__heading">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.intro != blank -%}
        <div class="altea-problem-solution__intro">{{ s.intro }}</div>
      {%- endif -%}
    </header>

    <div class="altea-problem-solution__grid">
      <article class="altea-problem-solution__panel altea-problem-solution__panel--problem">
        <div class="altea-problem-solution__panel-heading">
          <span class="altea-problem-solution__badge" aria-hidden="true">?</span>
          <div>
            <p class="altea-problem-solution__panel-eyebrow">{{ s.problem_eyebrow | escape }}</p>
            <h3 class="altea-problem-solution__panel-title">{{ s.problem_title }}</h3>
          </div>
        </div>
        <ul class="altea-problem-solution__list" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'problem' -%}
              <li class="altea-problem-solution__item" {{ block.shopify_attributes }}>
                <span class="altea-problem-solution__item-icon" aria-hidden="true">
                  {%- render 'material-icon', icon: block.settings.icon -%}
                </span>
                <span>
                  <strong>{{ block.settings.title }}</strong>
                  <span>{{ block.settings.text }}</span>
                </span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </article>

      <div class="altea-problem-solution__connector" aria-hidden="true">
        {%- render 'material-icon', icon: 'arrow_forward' -%}
      </div>

      <article class="altea-problem-solution__panel altea-problem-solution__panel--solution">
        <div class="altea-problem-solution__panel-heading">
          <span class="altea-problem-solution__badge" aria-hidden="true">
            {%- render 'material-icon', icon: 'verified' -%}
          </span>
          <div>
            <p class="altea-problem-solution__panel-eyebrow">{{ s.solution_eyebrow | escape }}</p>
            <h3 class="altea-problem-solution__panel-title">{{ s.solution_title }}</h3>
          </div>
        </div>
        <ul class="altea-problem-solution__list" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'solution' -%}
              <li class="altea-problem-solution__item" {{ block.shopify_attributes }}>
                <span class="altea-problem-solution__item-icon" aria-hidden="true">
                  {%- render 'material-icon', icon: block.settings.icon -%}
                </span>
                <span>
                  <strong>{{ block.settings.title }}</strong>
                  <span>{{ block.settings.text }}</span>
                </span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </article>
    </div>

    {%- if s.cta_label != blank -%}
      <a class="altea-problem-solution__cta button button--primary" href="{{ cta_href }}">
        {{ s.cta_label | escape }}
        {%- render 'material-icon', icon: 'arrow_downward' -%}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Altea — Problème →",
  "tag": "section",
  "class": "altea-problem-solution-section",
  "settings": [
    { "type": "header", "content": "En-tête" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "POURQUOI ALTEA" },
    { "type": "inline_richtext", "id": "heading", "label": "Titre", "default": "Le bon geste commence par le bon équipement" },
    { "type": "richtext", "id": "intro", "label": "Introduction" },
    { "type": "header", "content": "Colonne problème" },
    { "type": "text", "id": "problem_eyebrow", "label": "Sur-titre problème", "default": "LE PROBLÈME" },
    { "type": "inline_richtext", "id": "problem_title", "label": "Titre problème", "default": "Ce qui vous préoccupe au quotidien" },
    { "type": "header", "content": "Colonne solution" },
    { "type": "text", "id": "solution_eyebrow", "label": "Sur-titre solution", "default": "LA SOLUTION ALTEA" },
    { "type": "inline_richtext", "id": "solution_title", "label": "Titre solution", "default": "Une réponse simple et prête à agir" },
    { "type": "header", "content": "Appel à l'action" },
    { "type": "text", "id": "cta_label", "label": "Libellé du bouton", "default": "Voir l'offre et commander" },
    { "type": "url", "id": "cta_link", "label": "Lien du bouton", "info": "Laisser vide pour pointer vers le bouton d'achat de la fiche produit." },
    { "type": "header", "content": "Affichage" },
    {
      "type": "select", "id": "show_on", "label": "Afficher sur", "default": "both",
      "options": [
        { "value": "both", "label": "Desktop et mobile" },
        { "value": "desktop-only", "label": "Desktop uniquement" },
        { "value": "mobile-only", "label": "Mobile uniquement" }
      ]
    },
    {
      "type": "select", "id": "container_size", "label": "Largeur du conteneur", "default": "page-width",
      "options": [
        { "value": "page-width", "label": "Standard" },
        { "value": "", "label": "Pleine largeur" }
      ]
    },
    {
      "type": "select", "id": "color_scheme", "label": "Schéma Debutify", "default": "scheme-1",
      "options": [
        { "value": "scheme-1", "label": "Clair" },
        { "value": "scheme-2", "label": "Primaire" },
        { "value": "scheme-3", "label": "Secondaire" },
        { "value": "scheme-4", "label": "Foncé" }
      ]
    },
    { "type": "color_scheme", "id": "custom_color_scheme", "label": "Schéma personnalisé", "default": "scheme-1" },
    { "type": "header", "content": "Espacement" },
    {
      "type": "select", "id": "padding___top", "label": "Marge haute", "default": "medium",
      "options": [
        { "value": "none", "label": "Aucune" },
        { "value": "extra_small", "label": "Très petite" },
        { "value": "small", "label": "Petite" },
        { "value": "medium", "label": "Moyenne" },
        { "value": "large", "label": "Grande" },
        { "value": "custom", "label": "Personnalisée" }
      ]
    },
    { "type": "range", "id": "custom_padding_top", "label": "Marge haute personnalisée", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    {
      "type": "select", "id": "padding___bottom", "label": "Marge basse", "default": "medium",
      "options": [
        { "value": "none", "label": "Aucune" },
        { "value": "extra_small", "label": "Très petite" },
        { "value": "small", "label": "Petite" },
        { "value": "medium", "label": "Moyenne" },
        { "value": "large", "label": "Grande" },
        { "value": "custom", "label": "Personnalisée" }
      ]
    },
    { "type": "range", "id": "custom_padding_bottom", "label": "Marge basse personnalisée", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "problem",
      "name": "Point de friction",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icône", "default": "priority_high" },
        { "type": "inline_richtext", "id": "title", "label": "Titre", "default": "Un irritant concret" },
        { "type": "textarea", "id": "text", "label": "Explication", "default": "Une phrase qui reformule la situation vécue par le client." }
      ]
    },
    {
      "type": "solution",
      "name": "Preuve de solution",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icône", "default": "check_circle" },
        { "type": "inline_richtext", "id": "title", "label": "Titre", "default": "Une réponse utile" },
        { "type": "textarea", "id": "text", "label": "Explication", "default": "Une phrase qui montre le bénéfice concret du produit." }
      ]
    }
  ]
}
{% endschema %}
