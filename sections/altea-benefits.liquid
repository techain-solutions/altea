{%- comment -%}
  ALTEA — Grille de benefices

  Section reutilisable : un bloc = un benefice (icone + titre + texte).
  Sert d'accroche « pourquoi ce produit » juste sous la colonne d'achat.

  Comme altea-product-specs, la section n'est PAS gatee derriere
  widget-blocker : c'est du contenu produit, il ne doit pas disparaitre.

  Ecrite en proprietes logiques : RTL natif, aucune surcharge necessaire.
{%- endcomment -%}

{{ 'section-altea-benefits.css' | asset_url | stylesheet_tag }}
{%- render 'section-padding', section: section -%}

{%- liquid
  assign s = section.settings
-%}

<section
  class="altea-benefits show-on--{{ s.show_on }} color-{{ s.custom_color_scheme }} dbtfy-color-{{ s.color_scheme }} section-{{ section.id }}-padding gradient{% if s.center_header %} altea-benefits--center{% endif %}"
  {{ section.shopify_attributes }}
>
  <div class="{{ s.container_size }}">
    {%- if s.eyebrow != blank or s.heading != blank or s.intro != blank -%}
      <div class="altea-benefits__header">
        {%- if s.eyebrow != blank -%}
          <p class="altea-benefits__eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="altea-benefits__heading">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.intro != blank -%}
          <div class="altea-benefits__intro">{{ s.intro }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="altea-benefits__grid altea-benefits__grid--{{ s.columns_desktop }}" role="list">
        {%- for block in section.blocks -%}
          <li class="altea-benefits__card" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <span class="altea-benefits__icon">
                {%- render 'material-icon', icon: block.settings.icon -%}
              </span>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="altea-benefits__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="altea-benefits__text">{{ block.settings.text }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Altea — Bénéfices",
  "tag": "section",
  "class": "altea-benefits-section",
  "settings": [
    { "type": "header", "content": "En-tête" },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "POURQUOI CE PRODUIT"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "Les points essentiels"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction"
    },
    {
      "type": "checkbox",
      "id": "center_header",
      "label": "Centrer l'en-tête",
      "default": true
    },
    { "type": "header", "content": "Grille" },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Colonnes sur desktop",
      "default": "4",
      "options": [
        { "value": "2", "label": "2 colonnes" },
        { "value": "3", "label": "3 colonnes" },
        { "value": "4", "label": "4 colonnes" }
      ]
    },
    { "type": "header", "content": "Affichage" },
    {
      "type": "select",
      "id": "show_on",
      "label": "Afficher sur",
      "default": "both",
      "options": [
        { "value": "both", "label": "Desktop et mobile" },
        { "value": "desktop-only", "label": "Desktop uniquement" },
        { "value": "mobile-only", "label": "Mobile uniquement" }
      ]
    },
    {
      "type": "select",
      "id": "container_size",
      "label": "Largeur du conteneur",
      "info": "« Standard » applique la classe page-width du thème.",
      "default": "page-width",
      "options": [
        { "value": "page-width", "label": "Standard" },
        { "value": "", "label": "Pleine largeur" }
      ]
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Schéma de couleurs Debutify",
      "default": "scheme-1",
      "options": [
        { "value": "scheme-1", "label": "Clair" },
        { "value": "scheme-2", "label": "Primaire" },
        { "value": "scheme-3", "label": "Secondaire" },
        { "value": "scheme-4", "label": "Foncé" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "custom_color_scheme",
      "label": "Schéma de couleurs personnalisé",
      "default": "scheme-1"
    },
    { "type": "header", "content": "Espacement" },
    {
      "type": "select",
      "id": "padding___top",
      "label": "Marge haute",
      "default": "medium",
      "options": [
        { "value": "none", "label": "Aucune" },
        { "value": "extra_small", "label": "Très petite" },
        { "value": "small", "label": "Petite" },
        { "value": "medium", "label": "Moyenne" },
        { "value": "large", "label": "Grande" },
        { "value": "custom", "label": "Personnalisée" }
      ]
    },
    {
      "type": "range",
      "id": "custom_padding_top",
      "label": "Marge haute personnalisée",
      "min": 0, "max": 160, "step": 4, "unit": "px",
      "default": 60
    },
    {
      "type": "select",
      "id": "padding___bottom",
      "label": "Marge basse",
      "default": "medium",
      "options": [
        { "value": "none", "label": "Aucune" },
        { "value": "extra_small", "label": "Très petite" },
        { "value": "small", "label": "Petite" },
        { "value": "medium", "label": "Moyenne" },
        { "value": "large", "label": "Grande" },
        { "value": "custom", "label": "Personnalisée" }
      ]
    },
    {
      "type": "range",
      "id": "custom_padding_bottom",
      "label": "Marge basse personnalisée",
      "min": 0, "max": 160, "step": 4, "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Bénéfice",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icône",
          "info": "Nom d'un symbole Material (ex. shield, sensors, bolt, ac_unit).",
          "default": "shield"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Titre",
          "default": "Titre du bénéfice"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Une phrase courte qui explique le bénéfice."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Altea — Bénéfices",
      "blocks": [
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" }
      ]
    }
  ]
}
{% endschema %}
