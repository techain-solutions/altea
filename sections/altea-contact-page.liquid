{{ 'altea-info-pages.css' | asset_url | stylesheet_tag }}

{%- assign faq_page = pages['faq'] -%}
{%- assign faq_url = faq_page.url | default: '/pages/faq' -%}
{%- assign tracking_page = pages['order-tracking'] -%}
{%- assign tracking_url = tracking_page.url | default: '/pages/order-tracking' -%}

<section class="altea-info-page altea-contact-page" id="AlteaContact-{{ section.id }}">
  <div class="altea-info-page__shell">
    <header class="altea-info-page__hero">
      <p class="altea-info-page__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1>{{ section.settings.heading | escape }} <em>{{ section.settings.heading_accent | escape }}</em></h1>
      <div class="altea-info-page__hero-copy">{{ section.settings.intro }}</div>
    </header>

    <div class="altea-info-page__trust-row" role="list">
      {%- for block in section.blocks -%}
        <div class="altea-info-page__trust-item" role="listitem" {{ block.shopify_attributes }}>
          <span class="altea-info-page__trust-icon" aria-hidden="true">{% render 'material-icon', icon: block.settings.icon %}</span>
          <span><strong>{{ block.settings.title | escape }}</strong><span>{{ block.settings.text | escape }}</span></span>
        </div>
      {%- endfor -%}
    </div>

    <div class="altea-info-page__contact-layout">
      <aside class="altea-info-page__contact-card">
        <p class="altea-info-page__eyebrow">{{ section.settings.card_eyebrow | escape }}</p>
        <h2>{{ section.settings.card_heading }}</h2>
        <p>{{ section.settings.card_text }}</p>
        <div class="altea-info-page__contact-links">
          <a class="altea-info-page__contact-link" href="{{ faq_url }}">{% render 'material-icon', icon: 'help' %}<span>{{ section.settings.faq_link_label | escape }}</span></a>
          <a class="altea-info-page__contact-link" href="{{ tracking_url }}">{% render 'material-icon', icon: 'local_shipping' %}<span>{{ section.settings.tracking_link_label | escape }}</span></a>
          <a class="altea-info-page__contact-link" href="mailto:{{ section.settings.email | escape }}">{% render 'material-icon', icon: 'mail' %}<span>{{ section.settings.email | escape }}</span></a>
        </div>
      </aside>

      <div class="altea-info-page__form-card">
        <h2>{{ section.settings.form_heading | escape }}</h2>
        <p class="altea-info-page__form-note">{{ section.settings.form_note | escape }}</p>
        {%- form 'contact', id: 'AlteaContactForm', class: 'altea-info-page__form' -%}
          {%- if form.posted_successfully? -%}
            <p class="altea-info-page__form-success" tabindex="-1" autofocus>{{ section.settings.success_message | escape }}</p>
          {%- elsif form.errors -%}
            <div class="altea-info-page__form-errors" role="alert">{{ 'templates.contact.form.error_heading' | t }} {{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="altea-info-page__form-grid">
            <div class="altea-info-page__field"><label for="AlteaContact-name">{{ section.settings.name_label | escape }}</label><input id="AlteaContact-name" type="text" name="contact[name]" autocomplete="name" required></div>
            <div class="altea-info-page__field"><label for="AlteaContact-email">{{ section.settings.email_label | escape }}</label><input id="AlteaContact-email" type="email" name="contact[email]" autocomplete="email" required></div>
            <div class="altea-info-page__field"><label for="AlteaContact-phone">{{ section.settings.phone_label | escape }}</label><input id="AlteaContact-phone" type="tel" name="contact[phone]" autocomplete="tel"></div>
            <div class="altea-info-page__field"><label for="AlteaContact-order">{{ section.settings.order_label | escape }}</label><input id="AlteaContact-order" type="text" name="contact[order_number]" autocomplete="off"></div>
            <div class="altea-info-page__field altea-info-page__field--full"><label for="AlteaContact-message">{{ section.settings.message_label | escape }}</label><textarea id="AlteaContact-message" name="contact[body]" required></textarea></div>
          </div>
          <button class="altea-info-page__button altea-info-page__button--primary altea-info-page__form-submit" type="submit">{{ section.settings.submit_label | escape }} {% render 'material-icon', icon: 'arrow_forward' %}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ALTEA — Contact",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "ALTEA • À votre écoute" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Une question ?" },
    { "type": "text", "id": "heading_accent", "label": "Accent du titre", "default": "On vous répond." },
    { "type": "richtext", "id": "intro", "label": "Introduction", "default": "<p>Besoin d’un conseil avant de commander, d’une information sur votre livraison ou d’un suivi après-vente ? Notre équipe est là pour vous aider.</p>" },
    { "type": "text", "id": "card_eyebrow", "label": "Sur-titre de la carte", "default": "Besoin d’une réponse rapide ?" },
    { "type": "text", "id": "card_heading", "label": "Titre de la carte", "default": "On est là pour vous simplifier la vie." },
    { "type": "textarea", "id": "card_text", "label": "Texte de la carte", "default": "Consultez les réponses les plus fréquentes ou envoyez-nous votre demande. Chaque message est lu par notre équipe." },
    { "type": "text", "id": "faq_link_label", "label": "Lien FAQ", "default": "Voir les questions fréquentes" },
    { "type": "text", "id": "tracking_link_label", "label": "Lien suivi", "default": "Suivre ma commande" },
    { "type": "text", "id": "email", "label": "Email de contact", "default": "bonjour@alteastores.com" },
    { "type": "text", "id": "form_heading", "label": "Titre du formulaire", "default": "Écrivez-nous" },
    { "type": "textarea", "id": "form_note", "label": "Note du formulaire", "default": "Donnez-nous quelques détails pour que nous puissions vous répondre au plus vite." },
    { "type": "text", "id": "name_label", "label": "Champ nom", "default": "Votre nom" },
    { "type": "text", "id": "email_label", "label": "Champ email", "default": "Votre email" },
    { "type": "text", "id": "phone_label", "label": "Champ téléphone", "default": "Téléphone (facultatif)" },
    { "type": "text", "id": "order_label", "label": "Champ commande", "default": "Numéro de commande (facultatif)" },
    { "type": "text", "id": "message_label", "label": "Champ message", "default": "Comment pouvons-nous vous aider ?" },
    { "type": "text", "id": "submit_label", "label": "Bouton", "default": "Envoyer ma demande" },
    { "type": "text", "id": "success_message", "label": "Message de succès", "default": "Merci ! Votre message a bien été envoyé. Notre équipe revient vers vous rapidement." }
  ],
  "blocks": [
    { "type": "trust", "name": "Réassurance", "limit": 3, "settings": [
      { "type": "text", "id": "icon", "label": "Icône Material", "default": "verified" },
      { "type": "text", "id": "title", "label": "Titre", "default": "Réponse sous 24 h" },
      { "type": "text", "id": "text", "label": "Texte", "default": "Les jours ouvrés" }
    ] }
  ],
  "presets": [
    { "name": "ALTEA — Contact", "blocks": [
      { "type": "trust" },
      { "type": "trust", "settings": { "icon": "payments", "title": "Paiement à la livraison", "text": "Simple et rassurant" } },
      { "type": "trust", "settings": { "icon": "support_agent", "title": "Une vraie équipe", "text": "Basée au Maroc" } }
    ] }
  ]
}
{% endschema %}
