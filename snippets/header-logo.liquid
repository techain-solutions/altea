{% doc %}
Renders the ALTEA horizontal wordmark for the storefront header.
{% enddoc %}

<a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
  <span class="header__heading-logo-wrapper altea-wordmark notranslate" translate="no">
    <svg class="altea-wordmark__svg altea-wordmark__svg--navy" viewBox="0 0 184 36" role="img" aria-label="{{ shop.name | escape }}">
      <text x="0" y="28" font-family="Manrope, sans-serif" font-size="30" font-weight="700" letter-spacing="2">ALTEA</text>
    </svg>
    <svg class="altea-wordmark__svg altea-wordmark__svg--white" viewBox="0 0 184 36" role="img" aria-label="{{ shop.name | escape }}">
      <text x="0" y="28" font-family="Manrope, sans-serif" font-size="30" font-weight="700" letter-spacing="2">ALTEA</text>
    </svg>
  </span>
</a>
