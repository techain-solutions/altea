ass=\"fitnova-reassurance__grid\">\n\n      <!-- Card 1 -->\n      <article class=\"fitnova-reassurance__card\">\n\n        <div class=\"fitnova-reassurance__icon\" aria-hidden=\"true\">\n          <span class=\"material-symbols-rounded\">\n            fitness_center\n          <\/span>\n        <\/div>\n\n        <h3 class=\"fitnova-reassurance__title\">\n          Made for Every Move\n        <\/h3>\n\n        <p class=\"fitnova-reassurance__text\">\n          Explore versatile sportswear for training days, rest days,\n          and everyday movement.\n        <\/p>\n\n      <\/article>\n\n      <!-- Card 2 -->\n      <article class=\"fitnova-reassurance__card\">\n\n        <div class=\"fitnova-reassurance__icon\" aria-hidden=\"true\">\n          <span class=\"material-symbols-rounded\">\n            checkroom\n          <\/span>\n        <\/div>\n\n        <h3 class=\"fitnova-reassurance__title\">\n          Find Your Fit\n        <\/h3>\n\n        <p class=\"fitnova-reassurance__text\">\n          Discover available styles, colors, and sizes across the\n          FITNOVA collections.\n        <\/p>\n\n      <\/article>\n\n      <!-- Card 3 -->\n      <article class=\"fitnova-reassurance__card\">\n\n        <div class=\"fitnova-reassurance__icon\" aria-hidden=\"true\">\n          <span class=\"material-symbols-rounded\">\n            lock\n          <\/span>\n        <\/div>\n\n        <h3 class=\"fitnova-reassurance__title\">\n          Secure Checkout\n        <\/h3>\n\n        <p class=\"fitnova-reassurance__text\">\n          Complete your purchase through Shopify’s secure and protected\n          checkout experience.\n        <\/p>\n\n      <\/article>\n\n      <!-- Card 4 -->\n      <article class=\"fitnova-reassurance__card\">\n\n        <div class=\"fitnova-reassurance__icon\" aria-hidden=\"true\">\n          <span class=\"material-symbols-rounded\">\n            support_agent\n          <\/span>\n        <\/div>\n\n        <h3 class=\"fitnova-reassurance__title\">\n          Here to Help\n        <\/h3>\n\n        <p class=\"fitnova-reassurance__text\">\n          Questions about a product or order? Contact the FITNOVA team\n          for assistance.\n        <\/p>\n\n      <\/article>\n\n    <\/div>\n  <\/div>\n<\/section>\n\n\n<style>\n\n  \/* ========================================\n     FITNOVA REASSURANCE SECTION\n     ======================================== *\/\n\n  .fitnova-reassurance {\n\n    --fitnova-black: #111111;\n    --fitnova-white: #ffffff;\n    --fitnova-off-white: #f5f5f2;\n    --fitnova-green: #0cc982;\n    --fitnova-muted: #6b6b66;\n    --fitnova-border: #deded8;\n\n    width: 100%;\n    padding: 48px 24px 60px;\n\n    color: var(--fitnova-black);\n    background-color: var(--fitnova-white);\n\n    \/* Shopify Body Typography *\/\n    font-family: var(--font-body-family);\n    font-style: var(--font-body-style);\n    font-weight: var(--font-body-weight);\n  }\n\n\n  \/* ========================================\n     CONTAINER\n     ======================================== *\/\n\n  .fitnova-reassurance__inner {\n    width: 100%;\n    max-width: 1400px;\n    margin: 0 auto;\n  }\n\n\n  \/* ========================================\n     MAIN HEADING\n     DM SERIF DISPLAY\n     ======================================== *\/\n\n  .fitnova-reassurance__heading {\n\n    margin: 0 0 48px;\n\n    color: var(--fitnova-black);\n\n    font-family: var(--font-heading-family) !important;\n    font-style: var(--font-heading-style);\n    font-weight: var(--font-heading-weight);\n\n    font-size: clamp(32px, 4vw, 48px);\n\n    line-height: 1.05;\n\n    letter-spacing: normal;\n\n    text-align: center;\n\n    text-transform: none;\n  }\n\n\n  \/* FITNOVA green *\/\n\n  .fitnova-reassurance__heading span {\n    color: var(--fitnova-green);\n  }\n\n\n  \/* ========================================\n     GRID\n     ======================================== *\/\n\n  .fitnova-reassurance__grid {\n\n    display: grid;\n\n    grid-template-columns:\n      repeat(4, minmax(0, 1fr));\n\n    gap: 20px;\n  }\n\n\n  \/* ========================================\n     CARDS\n     ======================================== *\/\n\n  .fitnova-reassurance__card {\n\n    min-height: 290px;\n\n    padding: 36px 28px;\n\n    background-color:\n      var(--fitnova-off-white);\n\n    border:\n      1px solid var(--fitnova-border);\n\n    border-radius: 4px;\n\n    text-align: center;\n\n    transition:\n      transform 200ms ease,\n      background-color 200ms ease,\n      border-color 200ms ease;\n  }\n\n\n  \/* Hover *\/\n\n  .fitnova-reassurance__card:hover {\n\n    background-color:\n      var(--fitnova-black);\n\n    border-color:\n      var(--fitnova-black);\n\n    transform:\n      translateY(-4px);\n  }\n\n\n  \/* ========================================\n     ICON\n     ======================================== *\/\n\n  .fitnova-reassurance__icon {\n\n    display: flex;\n\n    align-items: center;\n    justify-content: center;\n\n    width: 56px;\n    height: 56px;\n\n    margin:\n      0 auto 32px;\n\n    color:\n      var(--fitnova-green);\n\n    border:\n      1px solid var(--fitnova-green);\n\n    border-radius:\n      50%;\n  }\n\n\n  \/* Material icon *\/\n\n  .fitnova-reassurance\n  .material-symbols-rounded {\n\n    font-size: 30px;\n\n    line-height: 1;\n\n    font-variation-settings:\n      \"FILL\" 0,\n      \"wght\" 500,\n      \"GRAD\" 0,\n      \"opsz\" 30;\n  }\n\n\n  \/* ========================================\n     CARD TITLES\n     DM SERIF DISPLAY\n     ======================================== *\/\n\n  .fitnova-reassurance__title {\n\n    margin:\n      0 0 14px;\n\n    color:\n      var(--fitnova-black);\n\n    font-family:\n      var(--font-heading-family) !important;\n\n    font-style:\n      var(--font-heading-style);\n\n    font-weight:\n      var(--font-heading-weight);\n\n    font-size:\n      20px;\n\n    line-height:\n      1.25;\n\n    letter-spacing:\n      normal;\n\n    text-align:\n      center;\n\n    text-transform:\n      none;\n\n    transition:\n      color 200ms ease;\n  }\n\n\n  \/* ========================================\n     CARD BODY TEXT\n     MARTEL\n     ======================================== *\/\n\n  .fitnova-reassurance__text {\n\n    margin: 0;\n\n    color:\n      var(--fitnova-muted);\n\n    font-family:\n      var(--font-body-family) !important;\n\n    font-style:\n      var(--font-body-style);\n\n    font-weight:\n      var(--font-body-weight);\n\n    font-size:\n      15px;\n\n    line-height:\n      1.6;\n\n    letter-spacing:\n      normal;\n\n    text-align:\n      center;\n\n    transition:\n      color 200ms ease;\n  }\n\n\n  \/* ========================================\n     HOVER TEXT\n     ======================================== *\/\n\n  .fitnova-reassurance__card:hover\n  .fitnova-reassurance__title,\n\n  .fitnova-reassurance__card:hover\n  .fitnova-reassurance__text {\n\n    color:\n      var(--fitnova-white);\n  }\n\n\n  \/* ========================================\n     TABLET\n     ======================================== *\/\n\n  @media (max-width: 990px) {\n\n    .fitnova-reassurance {\n\n      padding:\n        72px 24px;\n    }\n\n\n    .fitnova-reassurance__grid {\n\n      grid-template-columns:\n        repeat(2, minmax(0, 1fr));\n    }\n\n  }\n\n\n  \/* ========================================\n     MOBILE\n     ======================================== *\/\n\n  @media (max-width: 600px) {\n\n    .fitnova-reassurance {\n\n      padding:\n        56px 16px;\n    }\n\n\n    .fitnova-reassurance__heading {\n\n      margin-bottom:\n        32px;\n\n      font-size:\n        32px;\n    }\n\n\n    .fitnova-reassurance__grid {\n\n      grid-template-columns:\n        1fr;\n\n      gap:\n        16px;\n    }\n\n\n    .fitnova-reassurance__card {\n\n      min-height:\n        auto;\n\n      padding:\n        28px 24px;\n    }\n\n\n    .fitnova-reassurance__icon {\n\n      margin:\