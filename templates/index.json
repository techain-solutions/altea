    "custom_liquid_L4X8xi": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.name",
      "settings": {
        "show_on": "both",
        "custom_liquid": "<link\n  rel=\"stylesheet\"\n  href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\"\n>\n\n<section class=\"altea-reassurance\">\n  <div class=\"altea-reassurance__inner\">\n\n    <div class=\"altea-reassurance__header\">\n\n      <p class=\"altea-reassurance__eyebrow\">\n        VOTRE SÉRÉNITÉ, NOTRE PRIORITÉ\n      </p>\n\n      <h2 class=\"altea-reassurance__heading\">\n        Pourquoi choisir <span>ALTEA</span> ?\n      </h2>\n\n      <p class=\"altea-reassurance__intro\">\n        Une expérience pensée pour rendre vos achats\n        plus simples, plus fluides et plus rassurants.\n      </p>\n\n    </div>\n\n\n    <div class=\"altea-reassurance__grid\">\n\n      <!-- Card 1 -->\n      <article class=\"altea-reassurance__card\">\n\n        <div class=\"altea-reassurance__number\">\n          01\n        </div>\n\n        <div class=\"altea-reassurance__icon\" aria-hidden=\"true\">\n          <span class=\"material-symbols-rounded\">\n            payments\n          </span>\n        </div>\n\n        <h3 class=\"altea-reassurance__title\">\n          Paiement à la livraison\n        </h3>\n\n        <p class=\"altea-reassurance__text\">\n          Commandez simplement et réglez votre achat\n          à la réception de votre commande.\n        </p>\n\n      </article>\n\n\n      <!-- Card 2 -->\n      <article class=\"altea-reassurance__card\">\n\n        <div class=\"altea-reassurance__number\">\n          02\n        </div>\n\n        <div class=\"altea-reassurance__icon\" aria-hidden=\"true\">\n          <span class=\"material-symbols-rounded\">\n            local_shipping\n          </span>\n        </div>\n\n        <h3 class=\"altea-reassurance__title\">\n          Livraison au Maroc\n        </h3>\n\n        <p class=\"altea-reassurance__text\">\n          Une expérience de commande pensée pour\n          les besoins de nos clients au Maroc.\n        </p>\n\n      </article>\n\n\n      <!-- Card 3 -->\n      <article class=\"altea-reassurance__card\">\n\n        <div class=\"altea-reassurance__number\">\n          03\n        </div>\n\n        <div class=\"altea-reassurance__icon\" aria-hidden=\"true\">\n          <span class=\"material-symbols-rounded\">\n            package_2\n          </span>\n        </div>\n\n        <h3 class=\"altea-reassurance__title\">\n          Suivi de commande\n        </h3>\n\n        <p class=\"altea-reassurance__text\">\n          Retrouvez facilement les informations\n          liées au suivi de votre commande.\n        </p>\n\n      </article>\n\n\n      <!-- Card 4 -->\n      <article class=\"altea-reassurance__card\">\n\n        <div class=\"altea-reassurance__number\">\n          04\n        </div>\n\n        <div class=\"altea-reassurance__icon\" aria-hidden=\"true\">\n          <span class=\"material-symbols-rounded\">\n            translate\n          </span>\n        </div>\n\n        <h3 class=\"altea-reassurance__title\">\n          Français &amp; Arabe\n        </h3>\n\n        <p class=\"altea-reassurance__text\">\n          Naviguez dans la langue qui vous convient\n          grâce à une expérience FR / AR adaptée.\n        </p>\n\n      </article>\n\n    </div>\n\n  </div>\n</section>\n\n\n<style>\n\n  /* ========================================\n     ALTEA REASSURANCE\n     ======================================== */\n\n  .altea-reassurance {\n\n    --altea-navy: #031D42;\n    --altea-gold: #D6A65E;\n    --altea-white: #FFFFFF;\n\n    --altea-cream: #F8F6F2;\n    --altea-card: #FBFAF7;\n\n    --altea-text: #031D42;\n    --altea-muted: #697586;\n\n    --altea-border:\n      rgba(3, 29, 66, 0.10);\n\n    width: 100%;\n\n    padding:\n      84px 24px 96px;\n\n    background:\n      var(--altea-white);\n\n    color:\n      var(--altea-text);\n\n    font-family:\n      var(--font-body-family);\n\n    font-style:\n      var(--font-body-style);\n\n    font-weight:\n      var(--font-body-weight);\n  }\n\n\n  /* ========================================\n     CONTAINER\n     ======================================== */\n\n  .altea-reassurance__inner {\n\n    width: 100%;\n\n    max-width: 1400px;\n\n    margin: 0 auto;\n  }\n\n\n  /* ========================================\n     HEADER\n     ======================================== */\n\n  .altea-reassurance__header {\n\n    max-width: 720px;\n\n    margin:\n      0 auto 52px;\n\n    text-align: center;\n  }\n\n\n  /* Eyebrow */\n\n  .altea-reassurance__eyebrow {\n\n    margin:\n      0 0 14px;\n\n    font-family:\n      var(--font-body-family);\n\n    font-size:\n      11px;\n\n    font-weight:\n      700;\n\n    line-height:\n      1.2;\n\n    letter-spacing:\n      0.20em;\n\n    text-transform:\n      uppercase;\n\n    color:\n      var(--altea-gold);\n  }\n\n\n  /* Heading */\n\n  .altea-reassurance__heading {\n\n    margin: 0;\n\n    font-family:\n      var(--font-heading-family) !important;\n\n    font-style:\n      var(--font-heading-style);\n\n    font-weight:\n      var(--font-heading-weight);\n\n    font-size:\n      clamp(34px, 4vw, 52px);\n\n    line-height:\n      1.05;\n\n    letter-spacing:\n      -0.025em;\n\n    color:\n      var(--altea-navy);\n  }\n\n\n  .altea-reassurance__heading span {\n\n    color:\n      var(--altea-gold);\n  }\n\n\n  /* Intro */\n\n  .altea-reassurance__intro {\n\n    max-width:\n      590px;\n\n    margin:\n      18px auto 0;\n\n    font-family:\n      var(--font-body-family);\n\n    font-size:\n      15px;\n\n    line-height:\n      1.7;\n\n    color:\n      var(--altea-muted);\n  }\n\n\n  /* ========================================\n     GRID\n     ======================================== */\n\n  .altea-reassurance__grid {\n\n    display:\n      grid;\n\n    grid-template-columns:\n      repeat(4, minmax(0, 1fr));\n\n    gap:\n      18px;\n  }\n\n\n  /* ========================================\n     CARDS\n     ======================================== */\n\n  .altea-reassurance__card {\n\n    position:\n      relative;\n\n    min-height:\n      310px;\n\n    padding:\n      34px 28px 32px;\n\n    overflow:\n      hidden;\n\n    background:\n      var(--altea-card);\n\n    border:\n      1px solid\n      var(--altea-border);\n\n    border-radius:\n      12px;\n\n    text-align:\n      left;\n\n    transition:\n      transform 250ms ease,\n      background-color 250ms ease,\n      border-color 250ms ease,\n      box-shadow 250ms ease;\n  }\n\n\n  /* Gold line */\n\n  .altea-reassurance__card::before {\n\n    content: \"\";\n\n    position:\n      absolute;\n\n    top: 0;\n    left: 0;\n\n    width:\n      100%;\n\n    height:\n      3px;\n\n    background:\n      var(--altea-gold);\n\n    transform:\n      scaleX(0);\n\n    transform-origin:\n      left center;\n\n    transition:\n      transform 300ms ease;\n  }\n\n\n  /* Decorative glow */\n\n  .altea-reassurance__card::after {\n\n    content: \"\";\n\n    position:\n      absolute;\n\n    width:\n      150px;\n\n    height:\n      150px;\n\n    right:\n      -80px;\n\n    bottom:\n      -90px;\n\n    border-radius:\n      50%;\n\n    background:\n      rgba(214, 166, 94, 0.12);\n\n    opacity:\n      0;\n\n    transition:\n      opacity 250ms ease;\n  }\n\n\n  /* Hover */\n\n  .altea-reassurance__card:hover {\n\n    background:\n      var(--altea-navy);\n\n    border-color:\n      var(--altea-navy);\n\n    transform:\n      translateY(-6px);\n\n    box-shadow:\n      0 20px 50px\n      rgba(3, 29, 66, 0.12);\n  }\n\n\n  .altea-reassurance__card:hover::before {\n\n    transform:\n      scaleX(1);\n  }\n\n\n  .altea-reassurance__card:hover::after {\n\n    opacity:\n      1;\n  }\n\n\n  /* ========================================\n     NUMBER\n     ======================================== */\n\n  .altea-reassurance__number {\n\n    position:\n      absolute;\n\n    top:\n      25px;\n\n    right:\n      26px;\n\n    font-family:\n      var(--font-body-family);\n\n    font-size:\n      10px;\n\n    font-weight:\n      700;\n\n    letter-spacing:\n      0.12em;\n\n    color:\n      rgba(3, 29, 66, 0.30);\n\n    transition:\n      color 250ms ease;\n  }\n\n\n  .altea-reassurance__card:hover\n  .altea-reassurance__number {\n\n    color:\n      rgba(255, 255, 255, 0.32);\n  }\n\n\n  /* ========================================\n     ICON\n     ======================================== */\n\n  .altea-reassurance__icon {\n\n    display:\n      flex;\n\n    align-items:\n      center;\n\n    justify-content:\n      center;\n\n    width:\n      58px;\n\n    height:\n      58px;\n\n    margin:\n      0 0 34px;\n\n    color:\n      var(--altea-navy);\n\n    background:\n      rgba(214, 166, 94, 0.14);\n\n    border:\n      1px solid\n      rgba(214, 166, 94, 0.42);\n\n    border-radius:\n      50%;\n\n    transition:\n      color 250ms ease,\n      background-color 250ms ease,\n      border-color 250ms ease;\n  }\n\n\n  .altea-reassurance\n  .material-symbols-rounded {\n\n    font-size:\n      28px;\n\n    line-height:\n      1;\n\n    font-variation-settings:\n      \"FILL\" 0,\n      \"wght\" 450,\n      \"GRAD\" 0,\n      \"opsz\" 28;\n  }\n\n\n  .altea-reassurance__card:hover\n  .altea-reassurance__icon {\n\n    color:\n      var(--altea-navy);\n\n    background:\n      var(--altea-gold);\n\n    border-color:\n      var(--altea-gold);\n  }\n\n\n  /* ========================================\n     CARD TITLE\n     ======================================== */\n\n  .altea-reassurance__title {\n\n    position:\n      relative;\n\n    z-index:\n      2;\n\n    margin:\n      0 0 13px;\n\n    font-family:\n      var(--font-heading-family) !important;\n\n    font-style:\n      var(--font-heading-style);\n\n    font-weight:\n      var(--font-heading-weight);\n\n    font-size:\n      21px;\n\n    line-height:\n      1.25;\n\n    letter-spacing:\n      -0.01em;\n\n    color:\n      var(--altea-navy);\n\n    transition:\n      color 250ms ease;\n  }\n\n\n  /* ========================================\n     TEXT\n     ======================================== */\n\n  .altea-reassurance__text {\n\n    position:\n      relative;\n\n    z-index:\n      2;\n\n    margin: 0;\n\n    max-width:\n      270px;\n\n    font-family:\n      var(--font-body-family);\n\n    font-size:\n      14px;\n\n    line-height:\n      1.65;\n\n    color:\n      var(--altea-muted);\n\n    transition:\n      color 250ms ease;\n  }\n\n\n  /* ========================================\n     HOVER COLORS\n     ======================================== */\n\n  .altea-reassurance__card:hover\n  .altea-reassurance__title {\n\n    color:\n      var(--altea-white);\n  }\n\n\n  .altea-reassurance__card:hover\n  .altea-reassurance__text {\n\n    color:\n      rgba(255, 255, 255, 0.72);\n  }\n\n\n  /* ========================================\n     TABLET\n     ======================================== */\n\n  @media screen and (max-width: 990px) {\n\n    .altea-reassurance {\n\n      padding:\n        72px 24px 80px;\n    }\n\n\n    .altea-reassurance__grid {\n\n      grid-template-columns:\n        repeat(2, minmax(0, 1fr));\n\n      gap:\n        18px;\n    }\n\n\n    .altea-reassurance__card {\n\n      min-height:\n        280px;\n    }\n\n  }\n\n\n  /* ========================================\n     MOBILE\n     ======================================== */\n\n  @media screen and (max-width: 600px) {\n\n    .altea-reassurance {\n\n      padding:\n        58px 16px 64px;\n    }\n\n\n    .altea-reassurance__header {\n\n      margin-bottom:\n        34px;\n    }\n\n\n    .altea-reassurance__eyebrow {\n\n      margin-bottom:\n        11px;\n\n      font-size:\n        9px;\n\n      letter-spacing:\n        0.17em;\n    }\n\n\n    .altea-reassurance__heading {\n\n      font-size:\n        34px;\n    }\n\n\n    .altea-reassurance__intro {\n\n      margin-top:\n        14px;\n\n      font-size:\n        14px;\n\n      line-height:\n        1.6;\n    }\n\n\n    .altea-reassurance__grid {\n\n      grid-template-columns:\n        1fr;\n\n      gap:\n        12px;\n    }\n\n\n    .altea-reassurance__card {\n\n      min-height:\n        auto;\n\n      padding:\n        25px 22px 26px;\n\n      border-radius:\n        10px;\n    }\n\n\n    .altea-reassurance__icon {\n\n      width:\n        52px;\n\n      height:\n        52px;\n\n      margin-bottom:\n        22px;\n    }\n\n\n    .altea-reassurance\n    .material-symbols-rounded {\n\n      font-size:\n        25px;\n    }\n\n\n    .altea-reassurance__title {\n\n      margin-bottom:\n        9px;\n\n      font-size:\n        19px;\n    }\n\n\n    .altea-reassurance__text {\n\n      max-width:\n        100%;\n\n      font-size:\n        13px;\n    }\n\n  }\n\n\n  /* ========================================\n     ACCESSIBILITY\n     ======================================== */\n\n  @media (prefers-reduced-motion: reduce) {\n\n    .altea-reassurance__card,\n    .altea-reassurance__card::before,\n    .altea-reassurance__card::after,\n    .altea-reassurance__icon {\n\n      transition:\n        none;\n    }\n\n  }\n\n</style>",
