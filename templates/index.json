    "custom_liquid_VJ8fBX": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.name",
      "settings": {
        "show_on": "desktop-only",
        "custom_liquid": "<section class=\"altea-feature-banner\">\n  <div class=\"altea-feature-banner__media\">\n\n    <!--\n      Remplacer cette URL par une image lifestyle du détecteur de gaz & CO.\n      Idéalement : produit à droite, espace sombre / neutre à gauche pour le texte.\n    -->\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0770/8508/1652/files/smartgas.png?v=1788871250\"\n      alt=\"Détecteur de gaz et monoxyde de carbone ALTEA\"\n      class=\"altea-feature-banner__image\"\n      loading=\"lazy\"\n      width=\"2000\"\n      height=\"1000\"\n    >\n\n    <div class=\"altea-feature-banner__overlay\"></div>\n\n    <div class=\"altea-feature-banner__content page-width\">\n      <div class=\"altea-feature-banner__content-inner\">\n\n        <p class=\"altea-feature-banner__eyebrow\">\n          SÉCURITÉ • MAISON • SÉRÉNITÉ\n        </p>\n\n        <h2 class=\"altea-feature-banner__heading\">\n          Anticipez le danger.<br>\n          <span class=\"altea-feature-banner__gold\">\n            Protégez votre foyer.\n          </span>\n        </h2>\n\n        <p class=\"altea-feature-banner__text\">\n          Le détecteur de gaz &amp; CO ALTEA vous aide à surveiller\n          votre intérieur simplement, pour un quotidien plus serein.\n        </p>\n\n        <div class=\"altea-feature-banner__offer\">\n          <span class=\"altea-feature-banner__offer-label\">\n            OFFRE DU MOMENT\n          </span>\n\n          <span class=\"altea-feature-banner__offer-text\">\n            2 détecteurs à <strong>599 DH</strong>\n            <del>678 DH</del>\n          </span>\n        </div>\n\n        <a\n          href=\"/products/detecteur-gaz\"\n          class=\"altea-feature-banner__button\"\n        >\n          <span>Découvrir le détecteur</span>\n\n          <svg\n            class=\"altea-feature-banner__arrow\"\n            viewBox=\"0 0 14 10\"\n            aria-hidden=\"true\"\n          >\n            <path\n              fill=\"currentColor\"\n              fill-rule=\"evenodd\"\n              d=\"M8.537.808a.5.5 0 0 1 .817-.162l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 1 1-.708-.708L11.793 5.5H1a.5.5 0 0 1 0-1h10.793L8.646 1.354a.5.5 0 0 1-.109-.546\"\n              clip-rule=\"evenodd\"\n            />\n          </svg>\n        </a>\n\n      </div>\n    </div>\n\n    <div class=\"altea-feature-banner__signature\">\n      <span>PROTÉGER</span>\n      <span class=\"altea-feature-banner__dot\"></span>\n      <span>PRÉVENIR</span>\n      <span class=\"altea-feature-banner__dot\"></span>\n      <span>ALTEA</span>\n    </div>\n\n  </div>\n</section>\n\n<style>\n  .altea-feature-banner {\n    --altea-navy: #031D42;\n    --altea-gold: #D6A65E;\n    --altea-white: #FFFFFF;\n\n    width: 100%;\n    margin: 0;\n    padding: 0;\n  }\n\n  .altea-feature-banner__media {\n    position: relative;\n    min-height: 590px;\n    overflow: hidden;\n    background: var(--altea-navy);\n  }\n\n  .altea-feature-banner__image {\n    position: absolute;\n    inset: 0;\n\n    width: 100%;\n    height: 100%;\n\n    object-fit: cover;\n    object-position: center;\n\n    transition: transform 1.1s ease;\n  }\n\n  .altea-feature-banner:hover\n  .altea-feature-banner__image {\n    transform: scale(1.025);\n  }\n\n  /* Premium navy overlay */\n  .altea-feature-banner__overlay {\n    position: absolute;\n    inset: 0;\n    z-index: 1;\n\n    background:\n      linear-gradient(\n        90deg,\n        rgba(3, 29, 66, 0.96) 0%,\n        rgba(3, 29, 66, 0.88) 26%,\n        rgba(3, 29, 66, 0.62) 48%,\n        rgba(3, 29, 66, 0.18) 72%,\n        rgba(3, 29, 66, 0.04) 100%\n      );\n\n    pointer-events: none;\n  }\n\n  .altea-feature-banner__content {\n    position: relative;\n    z-index: 2;\n\n    display: flex;\n    align-items: center;\n\n    min-height: 590px;\n\n    padding-top: 72px;\n    padding-bottom: 72px;\n  }\n\n  .altea-feature-banner__content-inner {\n    width: 100%;\n    max-width: 660px;\n  }\n\n  .altea-feature-banner__eyebrow {\n    margin: 0 0 18px;\n\n    font-family: var(--font-body-family);\n    font-size: 12px;\n    font-weight: 700;\n\n    line-height: 1.2;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n\n    color: var(--altea-gold);\n  }\n\n  .altea-feature-banner__heading {\n    margin: 0;\n\n    max-width: 680px;\n\n    font-family: var(--font-heading-family) !important;\n    font-style: var(--font-heading-style);\n    font-weight: var(--font-heading-weight);\n\n    font-size: clamp(46px, 5.2vw, 74px);\n    line-height: 0.98;\n\n    letter-spacing: -0.03em;\n\n    color: var(--altea-white);\n  }\n\n  .altea-feature-banner__gold {\n    color: var(--altea-gold);\n  }\n\n  .altea-feature-banner__text {\n    max-width: 540px;\n\n    margin: 25px 0 0;\n\n    font-family: var(--font-body-family);\n    font-size: 16px;\n    line-height: 1.65;\n\n    color: rgba(255, 255, 255, 0.84);\n  }\n\n  /* Offer block */\n\n  .altea-feature-banner__offer {\n    display: flex;\n    flex-direction: column;\n    align-items: flex-start;\n\n    gap: 6px;\n\n    margin-top: 26px;\n    padding-left: 16px;\n\n    border-left: 2px solid var(--altea-gold);\n  }\n\n  .altea-feature-banner__offer-label {\n    font-family: var(--font-body-family);\n    font-size: 10px;\n    font-weight: 700;\n\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n\n    color: var(--altea-gold);\n  }\n\n  .altea-feature-banner__offer-text {\n    font-family: var(--font-body-family);\n    font-size: 18px;\n    line-height: 1.4;\n\n    color: var(--altea-white);\n  }\n\n  .altea-feature-banner__offer-text strong {\n    font-size: 22px;\n    color: var(--altea-gold);\n  }\n\n  .altea-feature-banner__offer-text del {\n    margin-left: 7px;\n\n    font-size: 14px;\n\n    color: rgba(255, 255, 255, 0.55);\n  }\n\n  /* CTA */\n\n  .altea-feature-banner__button {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n\n    gap: 14px;\n\n    min-height: 52px;\n\n    margin-top: 31px;\n    padding: 0 27px;\n\n    background: var(--altea-gold);\n    color: var(--altea-navy);\n\n    border: 1px solid var(--altea-gold);\n    border-radius: 4px;\n\n    font-family: var(--font-body-family);\n    font-size: 12px;\n    font-weight: 700;\n\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n    text-decoration: none;\n\n    transition:\n      background-color 200ms ease,\n      color 200ms ease,\n      border-color 200ms ease,\n      transform 200ms ease;\n  }\n\n  .altea-feature-banner__button:hover {\n    background: var(--altea-white);\n    border-color: var(--altea-white);\n    color: var(--altea-navy);\n\n    transform: translateY(-2px);\n  }\n\n  .altea-feature-banner__arrow {\n    width: 15px;\n    height: 11px;\n\n    transition: transform 200ms ease;\n  }\n\n  .altea-feature-banner__button:hover\n  .altea-feature-banner__arrow {\n    transform: translateX(4px);\n  }\n\n  /* Bottom signature */\n\n  .altea-feature-banner__signature {\n    position: absolute;\n    right: 30px;\n    bottom: 24px;\n\n    z-index: 3;\n\n    display: flex;\n    align-items: center;\n\n    gap: 10px;\n\n    font-family: var(--font-body-family);\n    font-size: 9px;\n    font-weight: 700;\n\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n\n    color: rgba(255, 255, 255, 0.76);\n  }\n\n  .altea-feature-banner__dot {\n    width: 4px;\n    height: 4px;\n\n    border-radius: 50%;\n\n    background: var(--altea-gold);\n  }\n\n  /* Tablet */\n\n  @media screen and (max-width: 990px) {\n    .altea-feature-banner__media,\n    .altea-feature-banner__content {\n      min-height: 540px;\n    }\n\n    .altea-feature-banner__heading {\n      font-size: clamp(42px, 7vw, 60px);\n    }\n  }\n\n  /* Mobile */\n\n  @media screen and (max-width: 749px) {\n    .altea-feature-banner__media,\n    .altea-feature-banner__content {\n      min-height: 570px;\n    }\n\n    .altea-feature-banner__image {\n      object-position: 64% center;\n    }\n\n    .altea-feature-banner__overlay {\n      background:\n        linear-gradient(\n          0deg,\n          rgba(3, 29, 66, 0.96) 0%,\n          rgba(3, 29, 66, 0.83) 45%,\n          rgba(3, 29, 66, 0.42) 72%,\n          rgba(3, 29, 66, 0.20) 100%\n        );\n    }\n\n    .altea-feature-banner__content {\n      align-items: flex-end;\n\n      padding-top: 52px;\n      padding-bottom: 48px;\n    }\n\n    .altea-feature-banner__content-inner {\n      max-width: 100%;\n    }\n\n    .altea-feature-banner__eyebrow {\n      margin-bottom: 12px;\n\n      font-size: 10px;\n    }\n\n    .altea-feature-banner__heading {\n      font-size: clamp(38px, 10vw, 50px);\n      line-height: 1;\n    }\n\n    .altea-feature-banner__text {\n      margin-top: 17px;\n\n      max-width: 410px;\n\n      font-size: 14px;\n      line-height: 1.55;\n    }\n\n    .altea-feature-banner__offer {\n      margin-top: 19px;\n    }\n\n    .altea-feature-banner__offer-text {\n      font-size: 16px;\n    }\n\n    .altea-feature-banner__offer-text strong {\n      font-size: 19px;\n    }\n\n    .altea-feature-banner__button {\n      min-height: 48px;\n\n      margin-top: 24px;\n      padding: 0 21px;\n\n      font-size: 11px;\n    }\n\n    .altea-feature-banner__signature {\n      display: none;\n    }\n  }\n\n  @media screen and (max-width: 480px) {\n    .altea-feature-banner__media,\n    .altea-feature-banner__content {\n      min-height: 550px;\n    }\n\n    .altea-feature-banner__heading {\n      font-size: 38px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .altea-feature-banner__image,\n    .altea-feature-banner__button,\n    .altea-feature-banner__arrow {\n      transition: none;\n    }\n\n    .altea-feature-banner:hover\n    .altea-feature-banner__image {\n      transform: none;\n    }\n  }\n</style>",
