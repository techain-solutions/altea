              "type": "_dbtfy-faq-question",
              "settings": {
                "heading": "",
                "open_by_default": false,
                "question": "<strong>Puis-je payer à la livraison ?</strong>",
                "answer": "<p>Oui. ALTEA propose le paiement à la livraison afin de faciliter vos achats au Maroc.</p>",
                "icon": ""
              },
              "blocks": {}
            },
            "dbtfy_faq_question_4RfjJC": {
