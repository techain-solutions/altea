          "blocks": {
            "faq_qEfvearh": {
              "type": "_dbtfy-faq-question",
              "settings": {
                "heading": "",
                "open_by_default": false,
                "question": "Quels sont les délais de livraison ?",
                "answer": "<p>Nous livrons partout au Maroc en 24 à 48h. Un SMS ou un appel vous confirme la commande avant expédition.</p>",
                "icon": ""
              }
            },
            "faq_tUcMiXTn": {
              "type": "_dbtfy-faq-question",
              "settings": {
                "heading": "",
                "open_by_default": false,
                "question": "Comment fonctionne le paiement à la livraison ?",
                "answer": "<p>Vous payez en espèces directement au livreur, après avoir vérifié votre colis. Aucun paiement en ligne n'est requis.</p>",
                "icon": ""
              }
            },
            "faq_0SezR5kp": {
              "type": "_dbtfy-faq-question",
              "settings": {
                "heading": "",
                "open_by_default": false,
                "question": "Puis-je retourner ou échanger un produit ?",
                "answer": "<p>Oui, vous disposez de 3 jours après réception pour un retour ou un échange, produit non utilisé et dans son emballage d'origine.</p>",
                "icon": ""
              }
            },
            "faq_W7ffUtx2": {
              "type": "_dbtfy-faq-question",
              "settings": {
                "heading": "",
                "open_by_default": false,
                "question": "Livrez-vous dans toutes les villes du Maroc ?",
                "answer": "<p>Oui, la livraison est gratuite et disponible dans toutes les grandes villes ainsi que dans la plupart des zones rurales.</p>",
                "icon": ""
              }
            },
            "faq_UO1TYNKd": {
              "type": "_dbtfy-faq-question",
              "settings": {
                "heading": "",
                "open_by_default": false,
                "question": "Comment puis-je vous contacter ?",
                "answer": "<p>Notre équipe est disponible sur WhatsApp tous les jours de 8h à 23h pour répondre à vos questions avant ou après votre achat.</p>",
                "icon": ""
              }
            },
            "faq_44vMbEMs": {
              "type": "_dbtfy-faq-question",
              "settings": {
                "heading": "",
                "open_by_default": false,
                "question": "Les produits sont-ils garantis ?",
                "answer": "<p>Oui, tous nos produits sont couverts contre les défauts de fabrication. Contactez-nous sur WhatsApp en cas de problème.</p>",
                "icon": ""
              }
            }
          },
