tom: 26px !important;\n  }\n\n  \/* Boutons *\/\n  .fitnova-about__cta-actions {\n    display: grid !important;\n    grid-template-columns: 1fr !important;\n    gap: 12px !important;\n    width: 100% !important;\n  }\n\n  .fitnova-about__cta-actions .fitnova-about__button {\n    width: 100% !important;\n    min-height: 52px !important;\n    padding: 0 18px !important;\n  }\n\n  \/* Cercle décoratif *\/\n  .fitnova-about__cta-inner::after {\n    width: 220px !important;\n    height: 220px !important;\n    top: -80px !important;\n    right: -110px !important;\n  }\n}\n\n<\/style>\n\n\n\n<script>\n\ndocument.addEventListener(\"DOMContentLoaded\", function () {\n\n  const sections =\n    document.querySelectorAll(\".fitnova-about\");\n\n\n  sections.forEach(function (section) {\n\n\n    \/*\n     * Hide Shopify default page title\n     *\/\n\n    const rteContainer =\n      section.closest(\".rte\");\n\n\n    const pageContainer =\n      rteContainer\n        ? rteContainer.parentElement\n        : section.parentElement;\n\n\n    if (pageContainer) {\n\n      const defaultPageTitle =\n        pageContainer.querySelector(\n          \"h1.main-page-title\"\n        );\n\n\n      if (defaultPageTitle) {\n\n        defaultPageTitle.style.display =\n          \"none\";\n\n      }\n\n    }\n\n\n\n    \/*\n     * Scroll animation\n     *\/\n\n    const animatedElements =\n      section.querySelectorAll(\n        [\n          \".fitnova-about__hero-content\",\n          \".fitnova-about__hero-visual\",\n          \".fitnova-about__section-heading\",\n          \".fitnova-about__card\",\n          \".fitnova-about__mission-visual\",\n          \".fitnova-about__mission-content\",\n          \".fitnova-about__step\",\n          \".fitnova-about__lifestyle-inner\",\n          \".fitnova-about__cta-inner\"\n        ].join(\",\")\n      );\n\n\n    animatedElements.forEach(\n      function (element, index) {\n\n        element.setAttribute(\n          \"data-fitnova-animate\",\n          \"\"\n        );\n\n\n        element.style.transitionDelay =\n          Math.min(index * 40, 220)\n          + \"ms\";\n\n      }\n    );\n\n\n    if (\n      !(\"IntersectionObserver\" in window)\n      ||\n      window.matchMedia(\n        \"(prefers-reduced-motion: reduce)\"\n      ).matches\n    ) {\n\n      animatedElements.forEach(\n        function (element) {\n\n          element.classList.add(\n            \"is-visible\"\n          );\n\n        }\n      );\n\n      return;\n\n    }\n\n\n    const observer =\n      new IntersectionObserver(\n\n        function (entries) {\n\n          entries.forEach(\n            function (entry) {\n\n              if (!entry.isIntersecting) {\n                return;\n              }\n\n\n              entry.target.classList.add(\n                \"is-visible\"\n              );\n\n\n              observer.unobserve(\n                entry.target\n              );\n\n            }\n          );\n\n        },\n\n        {\n          threshold: 0.10\n        }\n\n      );\n\n\n    animatedElements.forEach(\n      function (element) {\n\n        observer.observe(\n          element\n        );\n\n      }\n    );\n\n  });\n\n});\n\n<\/script>","color_scheme":"scheme-1","custom_color_scheme":"","padding___top":"custom","custom_padding_top":0,"padding___bottom":"custom","custom_padding_bottom":0}}},"order":["dbtfy-breadcrumbs","main","custom_liquid_Ca4geQ"]}